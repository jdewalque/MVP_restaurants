{
  "name": "@passaparola/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:generate": "prisma generate",
    "seed": "prisma generate && tsx --env-file-if-exists=.env prisma/seed.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@passaparola/shared": "*",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
