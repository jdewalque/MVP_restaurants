# --- Meta app (developers.facebook.com → your app → App settings → Basic) ---
META_APP_ID=
META_APP_SECRET=
# Graph API version used for every call.
META_GRAPH_VERSION=v26.0
# Must be listed in "Valid OAuth Redirect URIs" (Facebook Login → Settings).
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# Optional: Facebook Login for Business configuration ID (replaces the scope list when set).
META_LOGIN_CONFIG_ID=

# --- Database (SQLite file, relative to apps/dashboard) ---
DATABASE_URL=file:./prisma/dev.db

# --- Security ---
# 32 random bytes used to encrypt access tokens at rest: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Password for the /admin pages.
ADMIN_PASSWORD=
# Optional: lets a scheduled job call POST /api/sync with "Authorization: Bearer <SYNC_SECRET>".
SYNC_SECRET=

# --- Testing only ---
# Points the Meta client to a fake Graph API instead of https://graph.facebook.com. Leave empty.
META_GRAPH_BASE_URL=
